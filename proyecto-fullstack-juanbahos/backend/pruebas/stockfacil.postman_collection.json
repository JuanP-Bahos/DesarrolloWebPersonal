{
  "info": {
    "name": "StockFácil API",
    "description": "Pruebas de la API REST de StockFácil. Ejecuta las peticiones en orden (o usa Run collection). Requiere el backend encendido y, para el caso 409, haber ejecutado npm run seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. CRUD",
      "item": [
        {
          "name": "Salud del servidor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/salud",
              "host": [
                "{{api}}"
              ],
              "path": [
                "salud"
              ]
            }
          }
        },
        {
          "name": "Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es un arreglo\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/productos",
              "host": [
                "{{api}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/productos",
              "host": [
                "{{api}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"HOG-001\",\n  \"nombre\": \"Bombillo LED 9 W\",\n  \"descripcion\": \"Luz blanca, rosca E27\",\n  \"categoria\": \"Hogar\",\n  \"precio\": 6500,\n  \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Obtener producto por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/productos/{{id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "productos",
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "Reemplazar producto (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/productos/{{id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "productos",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"HOG-001\",\n  \"nombre\": \"Bombillo LED 12 W\",\n  \"descripcion\": \"Luz blanca, rosca E27\",\n  \"categoria\": \"Hogar\",\n  \"precio\": 8200,\n  \"stock\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Actualizar stock (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Stock actualizado\", () => pm.expect(pm.response.json().stock).to.eql(19));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/productos/{{id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "productos",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 19\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{api}}/productos/{{id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "productos",
                "{{id}}"
              ]
            }
          }
        }
      ]
    },
